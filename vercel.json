{
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/create-checkout-session.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
